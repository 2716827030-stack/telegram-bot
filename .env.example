# 变量名请用下划线。若写成「TELEGRAM BOT TOKEN=」这种带空格，保存为 .env 后程序也会自动转成 TELEGRAM_BOT_TOKEN。
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
RUNNINGHUB_API_KEY=your_runninghub_api_key
RUNNINGHUB_WORKFLOW_ID=2054569207894953986
# Optional: if the workflow uses encrypted access on RunningHub
# RUNNINGHUB_ACCESS_PASSWORD=
# ComfyUI node overrides (defaults match 123456.json: LoadImage id 16, TextEncodeQwenImageEditPlus id 5)
# RUNNINGHUB_LOAD_IMAGE_NODE_ID=16
# RUNNINGHUB_LOAD_IMAGE_FIELD=image
# RUNNINGHUB_PROMPT_NODE_ID=5
# RUNNINGHUB_PROMPT_FIELD=prompt
